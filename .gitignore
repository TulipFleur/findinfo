# secrets
config/.env
config/config.json
config/scope.json
bin/config.yaml
# runtime state (state lives in ~/.findinfo by default)
data/
runs/
cache/
# sqlite write-ahead sidecars (multi-agent / WAL mode)
*.db-wal
*.db-shm
_tmp/
ksubdomain.yaml
__pycache__/
*.pyc
# build artifacts
rust/onepass/target/
bin/*.exe
# per-platform binaries (bin/windows, bin/linux, bin/darwin) are never tracked
bin/*/

# runtime binary state
bin/*.gob
# per-session agent collaboration logs: local development record, not
# part of the shipped skill
agent-records/

# local release output (scripts/build-release*.py) and scratch dirs: these
# are produced artefacts, not sources -- rebuilding is the rule
_rel/
.tmprun/
.playwright-mcp/
.pytest_cache/

# ProjectDiscovery binaries write a per-tool config.yaml into the CWD on first
# run; a checkout that ran `httpx -version` once grew nine such directories and
# they were committed by accident. They hold no credentials (every provider is
# an empty list) and are regenerated on demand, so they must never be tracked.
# `bin/config.yaml` (the aiqicha Cookie) is a SECRET and is already ignored.
/cdncheck/
/chaos/
/dnsx/
/httpx/
/katana/
/naabu/
/subfinder/
/uncover/

# A shell wrote the literal text `%SystemDrive%` as a path (the variable was
# never expanded), producing this empty tree in the checkout.
/%SystemDrive%/
