# secrets
config/.env
config/config.json
config/scope.json
bin/config.yaml
# runtime state (state lives in ~/.findinfo by default)
data/
runs/
cache/
# sqlite write-ahead sidecars (multi-agent / WAL mode)
*.db-wal
*.db-shm
_tmp/
ksubdomain.yaml
__pycache__/
*.pyc
# build artifacts
rust/onepass/target/
bin/*.exe
# per-platform binaries (bin/windows, bin/linux, bin/darwin) are never tracked
bin/*/

# runtime binary state (agent-records/ IS tracked — see AGENT.md §7)
bin/*.gob
