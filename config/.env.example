# ============================================================================
# findinfo 配置文件  ——  API Key 存档
# ----------------------------------------------------------------------------
# 用法：
#   cp config/.env.example config/.env
#   然后按需填空。空值 = 该数据源未启用，流水线自动跳过并记录 degraded。
#
# 优先级：真实环境变量 > config/.env > config/config.json
# 兼容 redtools/exploit_server 的命名（FOFA_EMAIL / FOFA_KEY / QUAKE_TOKEN ...）
# ============================================================================

# ── 1. 网络空间测绘（阶段一：备案号反查 / 子域扩展 / org 反查）─────────────
# FOFA     申请：https://fofa.info/userInfo   免费额度：每月 200~300 条查询
FOFA_EMAIL=
FOFA_KEY=

# 360 Quake 申请：https://quake.360.net/quake/#/personalInfo  免费额度：每月 3000 条
QUAKE_TOKEN=

# 奇安信鹰图 Hunter 申请：https://hunter.qianxin.com/home/userInfo  免费额度：每月 100 积分
HUNTER_KEY=

# ZoomEye 申请：https://www.zoomeye.org/profile  免费额度：每月 2000 条
ZOOMEYE_KEY=

# Censys 申请：https://search.censys.io/account/api  免费额度：每月 250 次
CENSYS_ID=
CENSYS_SECRET=

# Shodan 申请：https://account.shodan.io/  免费额度：极低（建议付费）
SHODAN_KEY=

# ── 2. 被动子域 / 历史数据（阶段一 / 阶段三）──────────────────────────────
# SecurityTrails 申请：https://securitytrails.com/app/account/credentials  免费：50 次/月
SECURITYTRAILS_KEY=

# VirusTotal 申请：https://www.virustotal.com/gui/my-apikey  免费：4 次/分钟
VIRUSTOTAL_KEY=

# urlscan.io 申请：https://urlscan.io/user/profile/  免费：100 次/天
URLSCAN_KEY=

# ProjectDiscovery Chaos 申请：https://cloud.projectdiscovery.io/  免费
CHAOS_KEY=

# GitHub Token（阶段三：代码泄露搜索）申请：https://github.com/settings/tokens
# 只需要 public_repo 读权限；不配则跳过代码泄露环节
GITHUB_TOKEN=

# ── 3. 节流（测绘 API 共用，参考 redtools 的 MAPPING_API_INTERVAL_MS）──────
# 命中「调用API过于频繁」后，全局冷却会指数升级；单位毫秒
MAPPING_API_INTERVAL_MS=1500

# ============================================================================
# 注意：
#   1) 本文件不要提交到 git（已在 .gitignore 里排除）
#   2) 没有 key 也能跑：crt.sh / DNS / httpx / naabu / vhost / katana 全部不需要 key
#   3) 只有「备案号反查」和「多源被动子域」强依赖测绘 API
# ============================================================================
