# ============================================================================
# findinfo configuration  —  API key archive
# ----------------------------------------------------------------------------
# Usage:
#   cp config/.env.example config/.env
#   then fill in what you have. An empty value = that source is disabled;
#   the pipeline skips it automatically and records it as degraded.
#
# Priority: real environment variables > config/.env > config/config.json
# Names are compatible with redtools/exploit_server (FOFA_EMAIL / FOFA_KEY / QUAKE_TOKEN ...)
# ============================================================================

# -- 1. Cyberspace mapping (stage 1: ICP reverse lookup / subdomain expansion / org lookup) ----
# FOFA     signup: https://fofa.info/userInfo   free tier: 200~300 queries/month
FOFA_EMAIL=
FOFA_KEY=

# 360 Quake signup: https://quake.360.net/quake/#/personalInfo  free tier: 3000/month
QUAKE_TOKEN=

# QAX Hunter signup: https://hunter.qianxin.com/home/userInfo  free tier: 100 credits/month
HUNTER_KEY=

# ZoomEye signup: https://www.zoomeye.org/profile  free tier: 2000/month
ZOOMEYE_KEY=

# Censys signup: https://search.censys.io/account/api  free tier: 250/month
CENSYS_ID=
CENSYS_SECRET=

# Shodan signup: https://account.shodan.io/  free tier: very low (paid recommended)
SHODAN_KEY=

# -- 2. Passive subdomains / historical data (stage 1 / stage 3) ----------------
# SecurityTrails signup: https://securitytrails.com/app/account/credentials  free: 50/month
SECURITYTRAILS_KEY=

# VirusTotal signup: https://www.virustotal.com/gui/my-apikey  free: 4/minute
VIRUSTOTAL_KEY=

# urlscan.io signup: https://urlscan.io/user/profile/  free: 100/day
URLSCAN_KEY=

# ProjectDiscovery Chaos signup: https://cloud.projectdiscovery.io/  free
CHAOS_KEY=

# -- 3. Throttling (shared by mapping APIs; cf. redtools MAPPING_API_INTERVAL_MS) -
# After an "API called too frequently" hit, the global cooldown escalates exponentially; unit: ms
MAPPING_API_INTERVAL_MS=1500

# ============================================================================
# Notes:
#   1) Never commit this file to git (already excluded in .gitignore)
#   2) It runs without any key: crt.sh / DNS / httpx / naabu / vhost / katana need none
#   3) Only "ICP reverse lookup" and "multi-source passive subdomains" hard-depend on mapping APIs
# ============================================================================
